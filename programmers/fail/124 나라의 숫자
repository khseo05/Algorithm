#include <string>
#include <vector>
#include <algorithm>

using namespace std;

string solution(int n) {
    string answer = "";
    
    while (n > 0) {
        int num = n%3;
        n /= 3;
        
        if (num == 0) {
            answer += "4";
            n -= 1;
        } else {
            answer += to_string(num);
        }
    }
    
    reverse(answer.begin(), answer.end());
    
    return answer;
}