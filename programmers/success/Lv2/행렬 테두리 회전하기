#include <string>
#include <vector>
#include <unordered_set>
#include <algorithm>

using namespace std;

vector<int> solution(int rows, int columns, vector<vector<int>> queries) {
    vector<int> answer;
    vector<vector<int>> v(rows, vector<int>(columns, 0));
    int val = 1;
    for (int i=0; i<rows; i++) {
        for (int j=0; j<columns; j++) {
            v[i][j] = val;
            val += 1;
        }
    }
    
    for (auto x : queries) {
        int minval = 1e9;
        int startrow = x[0] - 1;  
        int startcol = x[1] - 1;  
        int endrow = x[2] - 1;    
        int endcol = x[3] - 1;    

        vector<vector<int>> snapshot = v;

        for (int i = startcol + 1; i <= endcol; i++) {  
            v[startrow][i] = snapshot[startrow][i-1]; 
            minval = min(minval, v[startrow][i]);
        }
        for (int i = startrow + 1; i <= endrow; i++) {  
            v[i][endcol] = snapshot[i-1][endcol];
            minval = min(minval, v[i][endcol]);
        }
        for (int i = endcol - 1; i >= startcol; i--) { 
            v[endrow][i] = snapshot[endrow][i+1];
            minval = min(minval, v[endrow][i]);
        }
        for (int i = endrow - 1; i >= startrow; i--) {  
            v[i][startcol] = snapshot[i+1][startcol];
            minval = min(minval, v[i][startcol]);
        }

        answer.push_back(minval);
    }

    return answer;
}