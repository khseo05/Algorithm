#include <string>
#include <sstream>
#include <vector>
using namespace std;

struct Pair {
    string name;
    string length;
    int diff;
};

string normalize(string s) {
    string res = "";
    for (int i = 0; i < s.size(); i++) {
        if (i + 1 < s.size() && s[i+1] == '#') {
            res += tolower(s[i]); // C# → c
            i++;
        } else {
            res += s[i];
        }
    }
    return res;
}

string solution(string m, vector<string> musicinfos) {
    string answer = "";
    m = normalize(m);
    vector<Pair> v;

    for (string music : musicinfos) {
        stringstream ss(music);
        string token;
        vector<string> mu;
        while (getline(ss, token, ',')) {
            mu.push_back(token);
        }

        string start = mu[0];
        string end   = mu[1];
        int sh = stoi(start.substr(0, 2));
        int sm = stoi(start.substr(3, 2));
        int eh = stoi(end.substr(0, 2));
        int em = stoi(end.substr(3, 2));
        int diff = (eh * 60 + em) - (sh * 60 + sm);

        string melody = normalize(mu[3]);
        if (melody.size() == 0) continue;

        int div    = diff / melody.size();
        int remain = diff % melody.size();
        string mlength = "";
        for (int i = 0; i < div; i++) mlength += melody;
        mlength += melody.substr(0, remain);

        v.push_back({mu[2], mlength, diff});
    }

    int d = -1;
    for (auto x : v) {
        if (x.length.size() < m.size()) continue;
        for (int i = 0; i <= x.length.size() - m.size(); i++) {
            if (m == x.length.substr(i, m.size())) {
                if (answer == "" || d < x.diff) {
                    answer = x.name;
                    d = x.diff;
                }
                break;
            }
        }
    }

    return answer == "" ? "(None)" : answer;
}